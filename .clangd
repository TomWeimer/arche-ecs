Documentation:
  CommentFormat: Doxygen

CompileFlags:
  Add:
    - -xc++
    - -std=c++20
    - -I/Users/student/Documents/arche-ecs/include
    - -I/Users/student/Documents/arche-ecs/src
    - -Wno-extra-semi
    - -Wno-missing-designated-field-initializers

---
If:
  PathMatch: .*\.inl
Diagnostics:
  Suppress: ["*"]
CompileFlags:
  Add:
    - -xc++
    - -std=c++20
    - -I/Users/student/Documents/arche-ecs/include
    - -I/Users/student/Documents/arche-ecs/src

---
If:
  PathMatch: src/query/query\.inl
CompileFlags:
  Add:
    - -include
    - arche/query.hpp

---
If:
  PathMatch: src/command/command_buffer\.inl
CompileFlags:
  Add:
    - -include
    - arche/command.hpp

---
If:
  PathMatch: src/system/access\.inl
CompileFlags:
  Add:
    - -include
    - system/access.hpp

---
If:
  PathMatch: src/world/world_access\.inl
CompileFlags:
  Add:
    - -include
    - world/world_access.hpp

---
If:
  PathMatch: src/entity/entity_allocator\.inl
CompileFlags:
  Add:
    - -include
    - entity/entity_allocator.hpp
    - -include
    - arche/world.hpp

---
If:
  PathMatch: src/entity/entity_view\.inl
CompileFlags:
  Add:
    - -include
    - arche/types/entity_ref.hpp
    - -include
    - arche/world.hpp

---
If:
  PathMatch: .*/build/.*
Diagnostics:
  Suppress: ["*"]
  UnusedIncludes: None
